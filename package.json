{
  "dependencies": {
    "@heroicons/react": "~2.2.0",
    "@radix-ui/react-avatar": "~1.2.6",
    "@radix-ui/react-dropdown-menu": "~2.1.24",
    "classnames": "~2.5.1",
    "feed": "~6.0.0",
    "next": "~16.3.3",
    "next-intl": "~4.14.1",
    "next-mdx-remote": "~6.0.0",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "rehype-autolink-headings": "~7.1.0",
    "rehype-mdx-code-props": "~3.0.1",
    "rehype-slug": "~6.0.0",
    "shiki": "~4.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@happy-dom/global-registrator": "^20.14.5",
    "@nodejs-loaders/tsx": "~1.2.1",
    "@storybook/nextjs": "~10.4.6",
    "@tailwindcss/postcss": "~4.3.3",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/react": "~16.3.2",
    "@types/node": "~26.6.3",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "next-themes": "~0.4.6",
    "storybook": "~10.4.6",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "biome:ci": "biome ci ./",
    "build": "next build",
    "dev": "next dev",
    "postbuild": "node ./scripts/postbuild.js",
    "pre-commit": "biome check ./ --write && node --run types:check && node --run test",
    "start": "next start",
    "storybook": "BUILD_ENV=storybook storybook dev -p 6006 --quiet --no-open",
    "storybook:build": "BUILD_ENV=storybook storybook build",
    "test": "node --run test:unit",
    "test:unit": "node --no-warnings --enable-source-maps --import ./node-hooks/react.ts --test **/tests/*.test.tsx **/tests/*.test.ts",
    "test:unit-coverage": "node --no-warnings --import ./node-hooks/react.ts --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=./coverage.lcov --test-reporter=spec --test-reporter-destination=stdout **/tests/*.test.tsx **/tests/*.test.ts",
    "test:watch": "node --no-warnings --enable-source-maps --import ./node-hooks/react.js --test --watch **/tests/*.test.tsx **/tests/*.test.ts",
    "types:check": "tsc --noEmit && echo 'No type errors!'"
  },
  "imports": {
    "#*": "./*"
  },
  "type": "module"
}
